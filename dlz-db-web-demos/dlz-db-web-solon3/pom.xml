<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>top.dlzio</groupId>
    <artifactId>dlz-db-web-solon3</artifactId>
    <version>8.0.0</version>
    <name>dlz-db-web-solon3</name>
    <description>DLZ-DB Solon 可运行示例（SQLite 零配置）</description>

    <properties>
        <java.version>8</java.version>
        <maven.compiler.release>8</maven.compiler.release>
        <maven.compiler.version>3.15.0</maven.compiler.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <solon.version>3.0.6</solon.version>
        <dlz-db.version>8.0.0</dlz-db.version>
        <sqlite.version>3.45.1.0</sqlite.version>
        <hikari.version>4.0.3</hikari.version>
        <lombok.version>1.18.30</lombok.version>
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <!-- Solon Web（含 MVC、HTTP 服务、JSON 序列化） -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-web</artifactId>
            <version>${solon.version}</version>
        </dependency>

        <!-- DLZ-DB Solon 插件（SPI 自动加载） -->
        <dependency>
            <groupId>top.dlzio</groupId>
            <artifactId>dlz-db-solon-plugin</artifactId>
            <version>${dlz-db.version}</version>
        </dependency>

        <!-- SQLite 驱动（零配置即可运行，无需外部数据库） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- 连接池（注册 DataSource 供 DLZ-DB 接管） -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikari.version}</version>
        </dependency>

        <!-- 日志实现（SLF4J 绑定，DLZ-DB 使用 slf4j-api 1.7.x） -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.2.13</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <!-- 示例工程不写入本地或远程仓库：跳过 install 和 deploy -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- 打包可执行 jar：java -jar target/dlz-db-web-solon3-8.0.0.jar -->
            <plugin>
                <groupId>org.noear</groupId>
                <artifactId>solon-maven-plugin</artifactId>
                <version>${solon.version}</version>
                <configuration>
                    <mainClass>com.example.demo.SolonWebApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 运行：mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.example.demo.SolonWebApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
