<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs 排除配置：框架内部 SQL 执行入口为误报 -->
<FindBugsFilter>
    <!-- SpringSqlExecutorAdapter：所有参数化查询方法均为框架内部 SQL 执行入口 -->
    <Match>
        <Class name="com.dlz.db.spring.SpringSqlExecutorAdapter"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="com.dlz.db.spring.SpringSqlExecutorAdapter"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>
    <Match>
        <Class name="com.dlz.db.spring.SpringSqlExecutorAdapter"/>
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION_EXCEPTION_EDGE"/>
    </Match>

    <!-- SolonSqlExecutorAdapter：所有参数化查询方法均为框架内部 SQL 执行入口 -->
    <Match>
        <Class name="com.dlz.db.solon.SolonSqlExecutorAdapter"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>
    <Match>
        <Class name="com.dlz.db.solon.SolonSqlExecutorAdapter"/>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>

    <!-- queryLastInsertIdByDialect：SQL 为方言固定常量拼接，非用户输入 -->
    <Match>
        <Class name="com.dlz.db.solon.SolonSqlExecutorAdapter"/>
        <Method name="queryLastInsertIdByDialect"/>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>

    <!-- Core raw-SQL API: callers supply statement structure while values are bound with PreparedStatement. -->
    <Match>
        <Class name="com.dlz.db.core.ISqlExecutor"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <!-- The dialect registry supplies fixed last-insert-id SQL, never request data. -->
    <Match>
        <Class name="com.dlz.db.core.NativeSqlUtil"/>
        <Method name="queryLastInsertIdByDialect"/>
        <Bug pattern="SQL_INJECTION_JDBC,SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>

    <!-- SegmentIdGenerator validates table names and binds all runtime values. -->
    <Match>
        <Class name="com.dlz.db.core.SegmentIdGenerator$SegmentBuffer"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <!-- testQuery is validated as a single read-only statement before execution. -->
    <Match>
        <Class name="com.dlz.db.ds.DBDynamic"/>
        <Method name="testConnection"/>
        <Bug pattern="SQL_INJECTION_JDBC,SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>

    <!-- URLs originate from the active ClassLoader and resource scanning accepts only local/jar protocols. -->
    <Match>
        <Class name="com.dlz.db.support.resouce.DlzResourceLoader"/>
        <Method name="tryOpenResourceStream"/>
        <Bug pattern="URLCONNECTION_SSRF_FD"/>
    </Match>
    <Match>
        <Class name="com.dlz.db.support.resouce.DlzResourceLoader"/>
        <Method name="collectFromClasspathRoots"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
</FindBugsFilter>
