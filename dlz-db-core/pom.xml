<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.dlzio</groupId>
        <artifactId>dlz-db</artifactId>
        <version>8.0.0</version>
    </parent>
    <name>dlz-db-core</name>
	<artifactId>dlz-db-core</artifactId>
	<packaging>jar</packaging>
    <description>DLZ-DB 核心模块，零 Spring 依赖</description>
	<dependencies>
        <!-- dlz-kit (无 Spring 依赖) -->
        <dependency>
            <groupId>top.dlzio</groupId>
            <artifactId>dlz-kit</artifactId>
            <version>${dlz-kit.version}</version>
        </dependency>



        <!-- JDBC -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>


        <!-- XML 解析 -->
<!--        <dependency>-->
<!--            <groupId>org.dom4j</groupId>-->
<!--            <artifactId>dom4j</artifactId>-->
<!--            <version>2.1.3</version>-->
<!--        </dependency>-->

        <!-- Swagger 注解 (test scope：仅用于测试中验证 io.swagger 兼容性，不传递给使用者) -->
        <dependency>
            <groupId>io.swagger</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>1.6.11</version>
            <scope>test</scope>
        </dependency>
        <!-- HikariCP (optional：主代码使用，但不传递给使用者) -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>4.0.3</version>
            <optional>true</optional>
        </dependency>
        <!-- SQLite JDBC for testing -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
            <scope>test</scope>
        </dependency>
	</dependencies>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
</project>
